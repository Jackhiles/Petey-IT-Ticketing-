# Copy to .env and fill in. Every setting Petey reads is listed here.

# --- Database -------------------------------------------------------------
# Used by docker/compose.yml to initialise the bundled Postgres container.
POSTGRES_USER=petey
POSTGRES_PASSWORD=change-me
POSTGRES_DB=petey

# Connection string for web, worker and Prisma migrations.
# Inside docker compose the host is "db"; for local development use localhost.
DATABASE_URL=postgresql://petey:change-me@localhost:5432/petey

# --- Application ----------------------------------------------------------
# Long random string (e.g. `openssl rand -base64 48`). Used to sign sessions and to
# encrypt secrets at rest such as mailbox credentials. Changing it invalidates them.
APP_SECRET=replace-with-a-long-random-string

# The URL people use to reach Petey, exactly as typed in the browser (scheme, host and
# port). Sign-in only accepts requests from this origin, and links in emails use it.
# Example for a homelab: APP_URL=http://192.168.1.20:3080
APP_URL=http://localhost:3000

# Port the web container publishes on the host.
WEB_PORT=3000

# Log level for web and worker: debug, info, warn, error.
LOG_LEVEL=info

# --- Attachments ----------------------------------------------------------
# Largest single attachment in MB. All files on one reply together may be twice this.
ATTACHMENT_MAX_MB=25
# Where attachments are stored outside Docker (compose uses a volume at /data/uploads).
# Defaults to .data/uploads under the web app's working directory.
# STORAGE_DIR=

# Sign-in rate limiting (on by default). Set to "off" only for automated test runs.
# AUTH_RATE_LIMIT=off
