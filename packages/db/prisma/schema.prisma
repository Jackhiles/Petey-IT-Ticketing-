// Petey database schema. Every change here ships as a migration in prisma/migrations.
// Tables arrive phase by phase; see docs/PLAN.md, "Data model".
// The connection URL lives in prisma.config.ts (Migrate) and src/index.ts (runtime).
//
// Conventions: Prisma models and fields are camelCase; tables and columns are snake_case
// via @@map/@map. Ids are UUIDs; times are timestamptz and always written in UTC.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

enum UserRole {
  requester
  technician
  admin
}

/// One table for requesters, technicians and admins. Better Auth reads and writes this
/// model as "user"; the password hash lives on the credential row in `accounts`.
model User {
  id               String   @id @default(uuid()) @db.Uuid
  email            String   @unique
  name             String
  emailVerified    Boolean  @default(false) @map("email_verified")
  image            String?
  role             UserRole @default(requester)
  departmentId     String?  @map("department_id") @db.Uuid
  isActive         Boolean  @default(true) @map("is_active")
  twoFactorEnabled Boolean  @default(false) @map("two_factor_enabled")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  department       Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  sessions         Session[]
  accounts         Account[]
  twoFactors       TwoFactor[]
  groupMemberships GroupMember[]
  auditEntries     AuditLog[]
  requestedTickets Ticket[]        @relation("TicketRequester")
  assignedTickets  Ticket[]        @relation("TicketAssignee")
  ticketMessages   TicketMessage[]
  attachments      Attachment[]
  savedViews       SavedView[]

  @@index([role])
  @@map("users")
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users User[]

  @@map("departments")
}

/// Technician support groups.
model Group {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String   @default("")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  members GroupMember[]
  tickets Ticket[]

  @@map("groups")
}

model GroupMember {
  id        String   @id @default(uuid()) @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

// ---------------------------------------------------------------------------
// Authentication (shapes required by Better Auth)
// ---------------------------------------------------------------------------

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Sign-in methods per user. Email and password is providerId "credential".
model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  password              String?
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Short-lived tokens such as password reset links.
model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

/// TOTP enrollment. The secret and backup codes are encrypted with APP_SECRET.
model TwoFactor {
  id                      String    @id @default(uuid()) @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  secret                  String
  backupCodes             String    @map("backup_codes")
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([secret])
  @@map("user_totp")
}

// ---------------------------------------------------------------------------
// Tickets
// ---------------------------------------------------------------------------

enum StatusType {
  open
  on_hold
  resolved
  closed
}

enum TicketType {
  incident
  request
}

enum TicketSource {
  agent
  portal
  email
  api
}

model Status {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  type      StatusType
  /// Read by the SLA timers in Phase 5; editable now so admins set it once.
  pausesSla Boolean    @default(false) @map("pauses_sla")
  sortOrder Int        @default(0) @map("sort_order")
  /// The status new tickets start in. Exactly one status is the default.
  isDefault Boolean    @default(false) @map("is_default")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  tickets Ticket[]

  @@map("statuses")
}

model Priority {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  /// Higher is more urgent; the list sorts by it.
  level     Int
  /// A hex colour such as #dc2626.
  color     String
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tickets Ticket[]

  @@map("priorities")
}

/// Two levels: a category (no parent) and its subcategories.
model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  parentId  String?  @map("parent_id") @db.Uuid
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent   Category?  @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryChildren")
  tickets  Ticket[]

  // Names are unique among siblings. Postgres treats NULL parents as distinct, so
  // packages/core also checks top-level names.
  @@unique([parentId, name])
  @@map("categories")
}

model Ticket {
  id              String       @id @default(uuid()) @db.Uuid
  /// Sequential number shown with the admin-set prefix, e.g. PTY-1234. Never reused.
  number          Int          @unique @default(autoincrement())
  type            TicketType   @default(incident)
  subject         String
  descriptionHtml String       @default("") @map("description_html")
  descriptionText String       @default("") @map("description_text")
  statusId        String       @map("status_id") @db.Uuid
  priorityId      String       @map("priority_id") @db.Uuid
  categoryId      String?      @map("category_id") @db.Uuid
  requesterId     String       @map("requester_id") @db.Uuid
  assigneeId      String?      @map("assignee_id") @db.Uuid
  groupId         String?      @map("group_id") @db.Uuid
  source          TicketSource @default(agent)
  resolvedAt      DateTime?    @map("resolved_at") @db.Timestamptz(3)
  closedAt        DateTime?    @map("closed_at") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Maintained by database triggers from subject, description and every message.
  searchVector    Unsupported("tsvector")? @map("search_vector")

  status      Status          @relation(fields: [statusId], references: [id], onDelete: Restrict)
  priority    Priority        @relation(fields: [priorityId], references: [id], onDelete: Restrict)
  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  requester   User            @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignee    User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  group       Group?          @relation(fields: [groupId], references: [id], onDelete: SetNull)
  messages    TicketMessage[]
  attachments Attachment[]

  @@index([statusId])
  @@index([assigneeId])
  @@index([groupId])
  @@index([requesterId])
  @@index([updatedAt])
  @@index([searchVector], type: Gin)
  @@map("tickets")
}

/// Public replies and internal notes. Requesters never see internal notes.
model TicketMessage {
  id         String       @id @default(uuid()) @db.Uuid
  ticketId   String       @map("ticket_id") @db.Uuid
  authorId   String?      @map("author_id") @db.Uuid
  /// Sanitized before it is stored.
  bodyHtml   String       @map("body_html")
  bodyText   String       @map("body_text")
  isInternal Boolean      @default(false) @map("is_internal")
  source     TicketSource @default(agent)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  attachments Attachment[]

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  ticketId     String   @map("ticket_id") @db.Uuid
  messageId    String?  @map("message_id") @db.Uuid
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  filename     String
  mimeType     String   @map("mime_type")
  size         Int
  /// Where the file lives in the configured storage backend.
  storageKey   String   @unique @map("storage_key")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  ticket     Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message    TicketMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploadedBy User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([messageId])
  @@map("attachments")
}

enum ViewVisibility {
  private
  shared
}

/// A named set of ticket list filters and sort. Shared views are visible to all technicians.
model SavedView {
  id         String         @id @default(uuid()) @db.Uuid
  name       String
  ownerId    String         @map("owner_id") @db.Uuid
  visibility ViewVisibility @default(private)
  /// The ticket list query (filters and sort), validated by Zod in packages/core.
  query      Json
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@map("saved_views")
}

// ---------------------------------------------------------------------------
// Settings and audit
// ---------------------------------------------------------------------------

/// Admin-editable settings, one JSON value per key, validated by Zod in packages/core.
model Setting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("settings")
}

/// Append-only record of every change made through packages/core.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  diff       Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}
