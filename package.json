{
  "name": "petey",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source, self-hosted IT service desk",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @petey/web start",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @petey/db generate",
    "db:migrate": "pnpm --filter @petey/db migrate:dev",
    "db:deploy": "pnpm --filter @petey/db migrate:deploy",
    "db:seed": "pnpm --filter @petey/db seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.0",
    "@petey/db": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "otpauth": "^9.5.2",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
